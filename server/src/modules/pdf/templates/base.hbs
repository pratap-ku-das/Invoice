<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{title}} {{doc.number}}</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@500;600;700&display=swap');

  :root {
    --primary: {{#if company.brandColor}}{{company.brandColor}}{{else}}#2563EB{{/if}};
    --secondary: #1E40AF;
    --accent: #10B981;
    --danger: #EF4444;
    --warning: #F59E0B;
    --border: #E5E7EB;
    --bg-subtle: #F8FAFC;
    --text-main: #111827;
    --text-muted: #6B7280;
  }

  @page {
    size: A4 portrait;
    margin: 12mm 12mm 16mm 12mm;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: var(--text-main);
    background: #ffffff;
    font-size: 12.5px;
    line-height: 1.5;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }

  .doc-wrapper {
    position: relative;
    padding: 0;
    min-height: 100%;
  }

  /* Watermark */
  .watermark {
    position: fixed;
    top: 45%;
    left: 50%;
    transform: translate(-50%, -50%) rotate(-25deg);
    font-size: 72px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: rgba(37, 99, 235, 0.035);
    pointer-events: none;
    z-index: 0;
    white-space: nowrap;
    text-transform: uppercase;
  }
  .watermark-paid { color: rgba(16, 185, 129, 0.04); }
  .watermark-unpaid { color: rgba(239, 68, 68, 0.04); }
  .watermark-cancelled { color: rgba(107, 114, 128, 0.04); }
  .watermark-draft { color: rgba(37, 99, 235, 0.04); }

  /* Utility Classes */
  .flex { display: flex; justify-content: space-between; gap: 16px; }
  .grid-2 { display: flex; gap: 16px; }
  .grid-2 > div { flex: 1; }
  .grid-3 { display: flex; gap: 16px; }
  .grid-3 > div { flex: 1; }
  .right { text-align: right; }
  .center { text-align: center; }
  .muted { color: var(--text-muted); }
  .bold { font-weight: 700; }
  .semi-bold { font-weight: 600; }
  .uppercase { text-transform: uppercase; }

  /* Cards */
  .card {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 12px 14px;
  }
  .card-title {
    font-size: 10.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  /* Header Card */
  .header-banner {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 2.5px solid var(--primary);
    padding-bottom: 16px;
    margin-bottom: 20px;
  }
  .company-logo {
    max-height: 56px;
    max-width: 200px;
    object-fit: contain;
    margin-bottom: 8px;
  }
  .company-name {
    font-size: 20px;
    font-weight: 800;
    color: var(--primary);
    line-height: 1.2;
    margin-bottom: 4px;
  }

  .doc-title {
    font-size: 26px;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--primary);
    line-height: 1.1;
    text-transform: uppercase;
  }

  /* Badges */
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    border: 1px solid transparent;
  }
  .badge-paid, .badge-accepted, .badge-delivered { background: #ECFDF5; color: #047857; border-color: #A7F3D0; }
  .badge-unpaid, .badge-rejected { background: #FEF2F2; color: #B91C1C; border-color: #FECACA; }
  .badge-partial, .badge-pending { background: #FFFBEB; color: #B45309; border-color: #FDE68A; }
  .badge-cancelled, .badge-expired { background: #F3F4F6; color: #374151; border-color: #E5E7EB; }
  .badge-draft { background: #EFF6FF; color: #1D4ED8; border-color: #BFDBFE; }
  .badge-converted { background: #F3E8FF; color: #6B21A8; border-color: #E9D5FF; }

  /* Tables */
  table { width: 100%; border-collapse: collapse; }
  .items-table {
    width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    margin-top: 20px;
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }
  .items-table th {
    background: var(--primary);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    padding: 10px 12px;
    text-align: left;
  }
  .items-table td {
    padding: 9px 12px;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    color: var(--text-main);
  }
  .items-table tr:last-child td { border-bottom: none; }
  .items-table tr:nth-child(even) td { background: var(--bg-subtle); }
  .items-table .num { text-align: right; }

  /* Totals Table */
  .totals-table { width: 100%; }
  .totals-table td { padding: 5px 8px; }
  .totals-table .grand-row td {
    padding: 10px 8px;
    font-size: 15px;
    font-weight: 800;
    color: var(--primary);
    border-top: 2px solid var(--primary);
    background: #EFF6FF;
    border-radius: 6px;
  }

  /* Signature & Footer */
  .signature-grid {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 36px;
    padding-top: 16px;
  }
  .signature-box {
    text-align: center;
    min-width: 160px;
  }
  .signature-line {
    border-top: 1px solid var(--text-muted);
    margin-top: 8px;
    padding-top: 4px;
    font-size: 11.5px;
    font-weight: 600;
  }

  .footer {
    margin-top: 40px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
    font-size: 10.5px;
    color: var(--text-muted);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
</style>
</head>
<body>
  <div class="doc-wrapper">
    {{#if doc.status}}
      <div class="watermark watermark-{{lower doc.status}}">{{upper doc.status}}</div>
    {{/if}}

    {{#if meta.thermal}}
      {{> theme_thermal}}
    {{else}}
      {{#if (eq meta.theme "professional")}}{{> theme_professional}}
      {{else if (eq meta.theme "gst")}}{{> theme_gst}}
      {{else if (eq meta.theme "minimal")}}{{> theme_minimal}}
      {{else if (eq meta.theme "corporate")}}{{> theme_corporate}}
      {{else if (eq meta.theme "blue")}}{{> theme_blue}}
      {{else if (eq meta.theme "dark")}}{{> theme_dark}}
      {{else if (eq meta.theme "classic")}}{{> theme_classic}}
      {{else}}{{> theme_modern}}{{/if}}
    {{/if}}

    <div class="footer">
      <div>
        <strong>{{company.name}}</strong> &bull; {{company.email}} &bull; {{company.phone}} {{#if company.website}}&bull; {{company.website}}{{/if}}
      </div>
      <div class="right">
        <span>Generated: {{nowDate}}</span> &bull; <em>Computer generated document</em>
      </div>
    </div>
  </div>
</body>
</html>
