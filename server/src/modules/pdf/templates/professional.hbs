<div class="doc" style="padding:36px; font-family:Georgia, 'Times New Roman', serif;">
  <div class="flex" style="align-items:flex-start;">
    <div>
      {{#if company.logo}}<img src="{{company.logo}}" style="max-height:60px;" />{{/if}}
      <div style="font-size:22px; font-weight:700;">{{company.name}}</div>
      <div class="muted">{{company.address.line1}}, {{company.address.city}} {{company.address.pincode}}</div>
      {{#if company.gstin}}<div class="muted">GSTIN: {{company.gstin}}</div>{{/if}}
    </div>
    <div class="right">
      <div style="font-size:26px; letter-spacing:.08em;">{{upper title}}</div>
      <div>#{{doc.number}}</div>
      <div class="muted">{{date doc.date}}</div>
    </div>
  </div>
  <div style="height:2px; background:#111; margin:16px 0;"></div>
  <div class="flex">
    <div><div class="section-title">Billed To</div><div style="font-weight:700;">{{doc.partyName}}</div><div class="muted">{{doc.billingAddress.city}} {{doc.billingAddress.state}}</div>{{#if doc.partyGstin}}<div class="muted">GSTIN: {{doc.partyGstin}}</div>{{/if}}</div>
    <div class="right"><div class="section-title">Reference</div><div class="muted">{{doc.referenceNumber}}</div>{{#if doc.dueDate}}<div class="muted">Due {{date doc.dueDate}}</div>{{/if}}</div>
  </div>
  <table class="items" style="margin-top:18px; border:1px solid #111;">
    <thead><tr style="border-bottom:2px solid #111;"><th>#</th><th>Description</th><th>HSN</th><th class="num">Qty</th><th class="num">Rate</th><th class="num">Amount</th></tr></thead>
    <tbody>{{#each doc.items}}<tr style="border-bottom:1px solid #d1d5db;"><td>{{inc @index}}</td><td>{{this.name}}</td><td>{{this.hsn}}</td><td class="num">{{this.qty}}</td><td class="num">{{money this.price}}</td><td class="num">{{money this.amount}}</td></tr>{{/each}}</tbody>
  </table>
  <div class="flex" style="margin-top:14px;">
    <div style="flex:1; font-style:italic;">{{words doc.grandTotal}}</div>
    <div style="width:260px;"><table class="totals">
      <tr><td>Subtotal</td><td class="right">{{money doc.subtotal company.currencySymbol}}</td></tr>
      {{#if doc.taxTotal}}<tr><td>Tax</td><td class="right">{{money doc.taxTotal company.currencySymbol}}</td></tr>{{/if}}
      <tr class="grand" style="border-top:2px solid #111;"><td>Total</td><td class="right">{{money doc.grandTotal company.currencySymbol}}</td></tr>
    </table></div>
  </div>
  <div class="signature">{{#if company.signature}}<img src="{{company.signature}}" style="max-height:52px;" /><br/>{{/if}}<div style="border-top:1px solid #111; display:inline-block; padding-top:4px;">Authorized Signatory</div></div>
</div>
