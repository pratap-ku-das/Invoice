<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{{title}} {{doc.number}}</title>
<style>
  :root {
    --accent: {{#if company.brandColor}}{{company.brandColor}}{{else}}#4f46e5{{/if}};
  }
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Segoe UI', 'Helvetica Neue', Arial, sans-serif;
    color: #1f2937;
    font-size: 12px;
    line-height: 1.5;
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .doc { padding: 0; }
  table { width: 100%; border-collapse: collapse; }
  .items th, .items td { padding: 8px 10px; text-align: left; }
  .items th { font-size: 11px; text-transform: uppercase; letter-spacing: .03em; }
  .items td.num, .items th.num { text-align: right; }
  .muted { color: #6b7280; }
  .right { text-align: right; }
  .totals td { padding: 4px 10px; }
  .totals .grand { font-size: 15px; font-weight: 700; }
  .section-title { font-size: 11px; text-transform: uppercase; letter-spacing: .05em; color: #6b7280; margin-bottom: 4px; }
  .badge { display: inline-block; padding: 2px 10px; border-radius: 999px; font-size: 11px; font-weight: 600; }
  .flex { display: flex; justify-content: space-between; gap: 16px; }
  .signature { margin-top: 40px; text-align: right; }
  .qr { display: flex; gap: 16px; align-items: center; margin-top: 12px; }
  .qr img { width: 96px; height: 96px; }
</style>
</head>
<body>
  {{#if meta.thermal}}
    {{> theme_thermal}}
  {{else}}
    {{#if (eq meta.theme "professional")}}{{> theme_professional}}
    {{else if (eq meta.theme "gst")}}{{> theme_gst}}
    {{else if (eq meta.theme "minimal")}}{{> theme_minimal}}
    {{else if (eq meta.theme "corporate")}}{{> theme_corporate}}
    {{else if (eq meta.theme "blue")}}{{> theme_blue}}
    {{else if (eq meta.theme "dark")}}{{> theme_dark}}
    {{else if (eq meta.theme "classic")}}{{> theme_classic}}
    {{else}}{{> theme_modern}}{{/if}}
  {{/if}}
</body>
</html>
