<div class="doc" style="padding: 24px 28px;">
  <!-- Header Banner -->
  <div class="header-banner">
    <div style="flex: 1.2;">
      {{#if company.logo}}
        <img src="{{company.logo}}" alt="company logo" class="company-logo" />
      {{/if}}
      <div class="company-name">{{company.name}}</div>
      <div class="muted">{{company.address.line1}} {{company.address.line2}}</div>
      <div class="muted">{{company.address.city}}{{#if company.address.state}}, {{company.address.state}}{{/if}} {{company.address.pincode}}</div>
      {{#if company.gstin}}<div class="muted" style="margin-top: 2px;"><strong>GSTIN:</strong> {{company.gstin}}</div>{{/if}}
      <div class="muted">
        {{#if company.phone}}<span>Ph: {{company.phone}}</span>{{/if}}
        {{#if company.email}} &bull; <span>{{company.email}}</span>{{/if}}
      </div>
    </div>

    <div class="right" style="flex: 0.8;">
      <div class="doc-title">{{upper title}}</div>
      <div style="font-size: 16px; font-weight: 800; color: var(--text-main); margin-top: 4px;">#{{doc.number}}</div>
      
      <div style="margin-top: 10px;" class="card">
        <div style="display: flex; justify-content: space-between; gap: 12px; margin-bottom: 3px;">
          <span class="muted">Date:</span>
          <span class="bold">{{date doc.date}}</span>
        </div>
        {{#if doc.dueDate}}
        <div style="display: flex; justify-content: space-between; gap: 12px; margin-bottom: 3px;">
          <span class="muted">Due Date:</span>
          <span class="bold">{{date doc.dueDate}}</span>
        </div>
        {{/if}}
        {{#if doc.status}}
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 6px; padding-top: 4px; border-top: 1px solid var(--border);">
          <span class="muted">Status:</span>
          <span class="badge badge-{{lower doc.status}}">{{upper doc.status}}</span>
        </div>
        {{/if}}
      </div>
    </div>
  </div>

  <!-- Info Cards Grid -->
  <div class="grid-2" style="margin-bottom: 20px;">
    <!-- Bill To Card -->
    <div class="card">
      <div class="card-title">Bill To / Customer Details</div>
      <div style="font-size: 14px; font-weight: 700; color: var(--text-main);">{{doc.partyName}}</div>
      {{#if doc.billingAddress.line1}}
        <div class="muted">{{doc.billingAddress.line1}} {{doc.billingAddress.line2}}</div>
        <div class="muted">{{doc.billingAddress.city}}{{#if doc.billingAddress.state}}, {{doc.billingAddress.state}}{{/if}} {{doc.billingAddress.pincode}}</div>
      {{/if}}
      {{#if doc.partyGstin}}<div style="margin-top: 4px;"><strong>GSTIN:</strong> {{doc.partyGstin}}</div>{{/if}}
      {{#if doc.partyPhone}}<div class="muted">Phone: {{doc.partyPhone}}</div>{{/if}}
      {{#if doc.partyEmail}}<div class="muted">Email: {{doc.partyEmail}}</div>{{/if}}
    </div>

    <!-- Ship To / Reference Card -->
    {{#if doc.shippingAddress.line1}}
    <div class="card">
      <div class="card-title">Ship To / Dispatch Details</div>
      <div style="font-weight: 600;">{{doc.partyName}}</div>
      <div class="muted">{{doc.shippingAddress.line1}} {{doc.shippingAddress.line2}}</div>
      <div class="muted">{{doc.shippingAddress.city}}{{#if doc.shippingAddress.state}}, {{doc.shippingAddress.state}}{{/if}} {{doc.shippingAddress.pincode}}</div>
    </div>
    {{else}}
    <div class="card">
      <div class="card-title">Document Reference &amp; Meta</div>
      <div style="display: flex; flex-direction: column; gap: 4px;">
        {{#if doc.placeOfSupply}}<div><span class="muted">Place of Supply:</span> <strong>{{doc.placeOfSupply}}</strong></div>{{/if}}
        {{#if doc.poNumber}}<div><span class="muted">P.O. Number:</span> <strong>{{doc.poNumber}}</strong></div>{{/if}}
        {{#if doc.vehicleNo}}<div><span class="muted">Vehicle No:</span> <strong>{{doc.vehicleNo}}</strong></div>{{/if}}
        {{#if doc.eWayBillNo}}<div><span class="muted">e-Way Bill No:</span> <strong>{{doc.eWayBillNo}}</strong></div>{{/if}}
      </div>
    </div>
    {{/if}}
  </div>

  <!-- Items Table -->
  <table class="items-table">
    <thead>
      <tr>
        <th style="width: 36px;" class="center">#</th>
        <th>Item Description</th>
        <th class="center" style="width: 85px;">HSN/SAC</th>
        <th class="num" style="width: 65px;">Qty</th>
        <th class="num" style="width: 95px;">Rate</th>
        <th class="num" style="width: 80px;">Disc</th>
        <th class="num" style="width: 65px;">Tax</th>
        <th class="num" style="width: 110px;">Amount</th>
      </tr>
    </thead>
    <tbody>
      {{#each doc.items}}
      <tr>
        <td class="center muted">{{inc @index}}</td>
        <td>
          <strong style="color: var(--text-main);">{{this.name}}</strong>
          {{#if this.description}}<div class="muted" style="font-size: 11px;">{{this.description}}</div>{{/if}}
        </td>
        <td class="center muted">{{#if this.hsn}}{{this.hsn}}{{else}}-{{/if}}</td>
        <td class="num bold">{{this.qty}}{{#if this.unitName}}<span class="muted" style="font-weight: normal;"> {{this.unitName}}</span>{{/if}}</td>
        <td class="num">{{money this.price}}</td>
        <td class="num muted">{{#if this.discount}}{{money this.discount}}{{else}}-{{/if}}</td>
        <td class="num muted">{{#if this.taxRate}}{{this.taxRate}}%{{else}}0%{{/if}}</td>
        <td class="num bold" style="color: var(--primary);">{{money this.amount}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Summary Section Grid -->
  <div class="grid-2" style="margin-top: 20px; align-items: flex-start;">
    <!-- Left Column: Words, QR Code & Notes -->
    <div style="flex: 1.1; display: flex; flex-direction: column; gap: 12px;">
      <div class="card">
        <div class="card-title">Amount in Words</div>
        <div style="font-weight: 600; color: var(--text-main);">{{words doc.grandTotal}}</div>
      </div>

      {{#if upiQr}}
      <div class="card" style="display: flex; align-items: center; gap: 14px;">
        <img src="{{upiQr}}" alt="UPI QR" style="width: 90px; height: 90px; border-radius: 6px; border: 1px solid var(--border);" />
        <div>
          <div class="card-title" style="margin-bottom: 2px;">Instant UPI Payment QR</div>
          <div style="font-weight: 700; color: var(--primary);">Scan with PhonePe, GPay or Paytm</div>
          {{#if company.upiId}}<div class="muted" style="font-size: 11px; margin-top: 2px;">VPA: <strong>{{company.upiId}}</strong></div>{{/if}}
        </div>
      </div>
      {{/if}}

      {{#if doc.notes}}
      <div class="card">
        <div class="card-title">Notes / Instructions</div>
        <div class="muted" style="white-space: pre-line;">{{doc.notes}}</div>
      </div>
      {{/if}}
    </div>

    <!-- Right Column: Dedicated Summary Card -->
    <div style="flex: 0.9;" class="card">
      <div class="card-title" style="border-bottom: 1px solid var(--border); padding-bottom: 4px; margin-bottom: 8px;">Financial Summary</div>
      <table class="totals-table">
        <tr>
          <td class="muted">Subtotal (Taxable)</td>
          <td class="right bold">{{money doc.subtotal company.currencySymbol}}</td>
        </tr>
        {{#if doc.docDiscount}}
        <tr>
          <td class="muted">Discount</td>
          <td class="right" style="color: var(--accent);">-{{money doc.docDiscount company.currencySymbol}}</td>
        </tr>
        {{/if}}
        {{#if doc.cgst}}
        <tr>
          <td class="muted">CGST</td>
          <td class="right">{{money doc.cgst company.currencySymbol}}</td>
        </tr>
        <tr>
          <td class="muted">SGST</td>
          <td class="right">{{money doc.sgst company.currencySymbol}}</td>
        </tr>
        {{/if}}
        {{#if doc.igst}}
        <tr>
          <td class="muted">IGST</td>
          <td class="right">{{money doc.igst company.currencySymbol}}</td>
        </tr>
        {{/if}}
        {{#if doc.cess}}
        <tr>
          <td class="muted">CESS</td>
          <td class="right">{{money doc.cess company.currencySymbol}}</td>
        </tr>
        {{/if}}
        {{#if doc.shippingCharge}}
        <tr>
          <td class="muted">Shipping / Freight</td>
          <td class="right">{{money doc.shippingCharge company.currencySymbol}}</td>
        </tr>
        {{/if}}
        {{#if doc.roundOff}}
        <tr>
          <td class="muted">Round Off</td>
          <td class="right">{{money doc.roundOff company.currencySymbol}}</td>
        </tr>
        {{/if}}
        <tr class="grand-row">
          <td>Grand Total</td>
          <td class="right">{{money doc.grandTotal company.currencySymbol}}</td>
        </tr>
        {{#if doc.paidAmount}}
        <tr style="border-top: 1px solid var(--border);">
          <td class="muted">Amount Paid</td>
          <td class="right" style="color: var(--accent);">{{money doc.paidAmount company.currencySymbol}}</td>
        </tr>
        <tr>
          <td><strong>Balance Due</strong></td>
          <td class="right bold" style="color: var(--danger); font-size: 14px;">{{money doc.balanceAmount company.currencySymbol}}</td>
        </tr>
        {{/if}}
      </table>
    </div>
  </div>

  <!-- Terms & Bank Details -->
  <div class="grid-2" style="margin-top: 20px;">
    {{#if company.bankName}}
    <div class="card">
      <div class="card-title">Bank Payment Details</div>
      <div style="font-weight: 700; color: var(--text-main);">{{company.bankName}}</div>
      <div><span class="muted">A/C No:</span> <strong>{{company.bankAccount}}</strong></div>
      <div><span class="muted">IFSC Code:</span> <strong>{{company.bankIfsc}}</strong></div>
      {{#if company.bankBranch}}<div class="muted">Branch: {{company.bankBranch}}</div>{{/if}}
    </div>
    {{/if}}

    {{#if doc.terms}}
    <div class="card">
      <div class="card-title">Terms &amp; Conditions</div>
      <div class="muted" style="white-space: pre-line; font-size: 11.5px;">{{doc.terms}}</div>
    </div>
    {{/if}}
  </div>

  <!-- Signature Section -->
  <div class="signature-grid">
    <div class="signature-box">
      <div class="signature-line">Customer Signature</div>
    </div>

    <div class="signature-box">
      <div class="signature-line">Prepared By</div>
    </div>

    <div class="signature-box">
      {{#if company.signature}}
        <img src="{{company.signature}}" alt="Authorized Signatory" style="max-height: 48px; object-fit: contain; margin-bottom: 4px;" /><br/>
      {{/if}}
      <div class="signature-line">Authorized Signatory</div>
      <div class="muted" style="font-size: 10.5px;">for {{company.name}}</div>
    </div>
  </div>
</div>
