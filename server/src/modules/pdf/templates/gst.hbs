<div class="doc" style="padding: 24px 28px;">
  <!-- Header Banner -->
  <div class="header-banner">
    <div style="flex: 1.2;">
      {{#if company.logo}}
        <img src="{{company.logo}}" alt="company logo" class="company-logo" />
      {{/if}}
      <div class="company-name">{{company.name}}</div>
      <div class="muted">{{company.address.line1}} {{company.address.line2}}</div>
      <div class="muted">{{company.address.city}}{{#if company.address.state}}, {{company.address.state}}{{/if}} {{company.address.pincode}}</div>
      {{#if company.gstin}}<div class="muted" style="margin-top: 2px;"><strong>GSTIN:</strong> {{company.gstin}}</div>{{/if}}
      <div class="muted">Ph: {{company.phone}} &bull; {{company.email}}</div>
    </div>

    <div class="right" style="flex: 0.8;">
      <div class="doc-title" style="color: var(--secondary);">GST TAX INVOICE</div>
      <div style="font-size: 15px; font-weight: 800; margin-top: 4px;">#{{doc.number}}</div>
      
      <div style="margin-top: 10px;" class="card">
        <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
          <span class="muted">Invoice Date:</span>
          <span class="bold">{{date doc.date}}</span>
        </div>
        {{#if doc.dueDate}}
        <div style="display: flex; justify-content: space-between; margin-bottom: 3px;">
          <span class="muted">Due Date:</span>
          <span class="bold">{{date doc.dueDate}}</span>
        </div>
        {{/if}}
        <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 4px; padding-top: 4px; border-top: 1px solid var(--border);">
          <span class="muted">Place of Supply:</span>
          <span class="bold">{{#if doc.placeOfSupply}}{{doc.placeOfSupply}}{{else}}{{company.address.state}}{{/if}}</span>
        </div>
      </div>
    </div>
  </div>

  <!-- B2B Customer Info Cards -->
  <div class="grid-2" style="margin-bottom: 20px;">
    <div class="card">
      <div class="card-title">Details of Receiver (Billed To)</div>
      <div style="font-size: 14px; font-weight: 700; color: var(--text-main);">{{doc.partyName}}</div>
      <div class="muted">{{doc.billingAddress.line1}} {{doc.billingAddress.line2}}</div>
      <div class="muted">{{doc.billingAddress.city}}{{#if doc.billingAddress.state}}, {{doc.billingAddress.state}}{{/if}} {{doc.billingAddress.pincode}}</div>
      <div style="margin-top: 4px;"><strong>GSTIN / UIN:</strong> {{#if doc.partyGstin}}{{doc.partyGstin}}{{else}}URP (Unregistered){{/if}}</div>
      {{#if doc.partyPhone}}<div class="muted">Phone: {{doc.partyPhone}}</div>{{/if}}
    </div>

    <div class="card">
      <div class="card-title">Details of Consignee (Shipped To)</div>
      <div style="font-weight: 600;">{{doc.partyName}}</div>
      {{#if doc.shippingAddress.line1}}
        <div class="muted">{{doc.shippingAddress.line1}} {{doc.shippingAddress.line2}}</div>
        <div class="muted">{{doc.shippingAddress.city}}{{#if doc.shippingAddress.state}}, {{doc.shippingAddress.state}}{{/if}} {{doc.shippingAddress.pincode}}</div>
      {{else}}
        <div class="muted">Same as billing address</div>
      {{/if}}
      {{#if doc.eWayBillNo}}<div style="margin-top: 4px;"><span class="muted">e-Way Bill No:</span> <strong>{{doc.eWayBillNo}}</strong></div>{{/if}}
    </div>
  </div>

  <!-- GST Items Breakdown Table -->
  <table class="items-table">
    <thead>
      <tr>
        <th style="width: 32px;" class="center">#</th>
        <th>Description of Goods / Services</th>
        <th class="center" style="width: 70px;">HSN/SAC</th>
        <th class="num" style="width: 50px;">Qty</th>
        <th class="num" style="width: 80px;">Rate</th>
        <th class="num" style="width: 80px;">Taxable</th>
        <th class="num" style="width: 70px;">CGST</th>
        <th class="num" style="width: 70px;">SGST</th>
        <th class="num" style="width: 70px;">IGST</th>
        <th class="num" style="width: 95px;">Total</th>
      </tr>
    </thead>
    <tbody>
      {{#each doc.items}}
      <tr>
        <td class="center muted">{{inc @index}}</td>
        <td><strong>{{this.name}}</strong></td>
        <td class="center muted">{{#if this.hsn}}{{this.hsn}}{{else}}-{{/if}}</td>
        <td class="num bold">{{this.qty}}</td>
        <td class="num">{{money this.price}}</td>
        <td class="num bold">{{money this.taxable}}</td>
        <td class="num muted">{{money this.cgst}}</td>
        <td class="num muted">{{money this.sgst}}</td>
        <td class="num muted">{{money this.igst}}</td>
        <td class="num bold" style="color: var(--primary);">{{money this.amount}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <!-- Summary Grid -->
  <div class="grid-2" style="margin-top: 20px; align-items: flex-start;">
    <div style="flex: 1.1; display: flex; flex-direction: column; gap: 12px;">
      <div class="card">
        <div class="card-title">Total Invoice Amount in Words</div>
        <div style="font-weight: 700; color: var(--text-main);">{{words doc.grandTotal}}</div>
      </div>

      {{#if upiQr}}
      <div class="card" style="display: flex; align-items: center; gap: 14px;">
        <img src="{{upiQr}}" alt="UPI QR" style="width: 84px; height: 84px; border-radius: 6px; border: 1px solid var(--border);" />
        <div>
          <div class="card-title" style="margin-bottom: 2px;">Digital Payment QR</div>
          <div style="font-weight: 700; color: var(--primary);">Scan &amp; Pay via UPI</div>
          {{#if company.upiId}}<div class="muted" style="font-size: 11px;">VPA: <strong>{{company.upiId}}</strong></div>{{/if}}
        </div>
      </div>
      {{/if}}
    </div>

    <div style="flex: 0.9;" class="card">
      <div class="card-title" style="border-bottom: 1px solid var(--border); padding-bottom: 4px; margin-bottom: 8px;">Tax Summary</div>
      <table class="totals-table">
        <tr>
          <td class="muted">Total Taxable Value</td>
          <td class="right bold">{{money doc.subtotal company.currencySymbol}}</td>
        </tr>
        <tr>
          <td class="muted">Central Tax (CGST)</td>
          <td class="right">{{money doc.cgst company.currencySymbol}}</td>
        </tr>
        <tr>
          <td class="muted">State Tax (SGST)</td>
          <td class="right">{{money doc.sgst company.currencySymbol}}</td>
        </tr>
        {{#if doc.igst}}
        <tr>
          <td class="muted">Integrated Tax (IGST)</td>
          <td class="right">{{money doc.igst company.currencySymbol}}</td>
        </tr>
        {{/if}}
        {{#if doc.roundOff}}
        <tr>
          <td class="muted">Round Off</td>
          <td class="right">{{money doc.roundOff company.currencySymbol}}</td>
        </tr>
        {{/if}}
        <tr class="grand-row">
          <td>Grand Total</td>
          <td class="right">{{money doc.grandTotal company.currencySymbol}}</td>
        </tr>
      </table>
    </div>
  </div>

  <!-- Bank Details & Terms -->
  <div class="grid-2" style="margin-top: 20px;">
    {{#if company.bankName}}
    <div class="card">
      <div class="card-title">Bank Account Details for NEFT/RTGS</div>
      <div style="font-weight: 700;">{{company.bankName}}</div>
      <div><span class="muted">Account No:</span> <strong>{{company.bankAccount}}</strong></div>
      <div><span class="muted">IFSC Code:</span> <strong>{{company.bankIfsc}}</strong></div>
    </div>
    {{/if}}

    {{#if doc.terms}}
    <div class="card">
      <div class="card-title">Terms &amp; Conditions</div>
      <div class="muted" style="white-space: pre-line; font-size: 11px;">{{doc.terms}}</div>
    </div>
    {{/if}}
  </div>

  <!-- Signatures -->
  <div class="signature-grid">
    <div class="signature-box"><div class="signature-line">Receiver's Signature</div></div>
    <div class="signature-box"><div class="signature-line">Checked By</div></div>
    <div class="signature-box">
      {{#if company.signature}}<img src="{{company.signature}}" alt="Sign" style="max-height: 48px;" /><br/>{{/if}}
      <div class="signature-line">Authorized Signatory</div>
      <div class="muted" style="font-size: 10.5px;">for {{company.name}}</div>
    </div>
  </div>
</div>
