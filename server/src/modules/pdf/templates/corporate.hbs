<div class="doc" style="padding: 24px 28px;">
  <div style="background: #1F2937; color: #ffffff; padding: 18px 20px; border-radius: 8px; margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center;">
    <div>
      <div style="font-size: 22px; font-weight: 800; color: #3B82F6;">{{company.name}}</div>
      <div style="font-size: 11.5px; opacity: 0.85;">{{company.address.line1}} {{company.address.line2}}, {{company.address.city}}</div>
      {{#if company.gstin}}<div style="font-size: 11px; opacity: 0.85;">GSTIN: {{company.gstin}}</div>{{/if}}
    </div>
    <div class="right">
      <div style="font-size: 24px; font-weight: 800; letter-spacing: 0.04em;">{{upper title}}</div>
      <div style="font-size: 15px; font-weight: 700; color: #60A5FA;">#{{doc.number}}</div>
      <div style="font-size: 11.5px; opacity: 0.85;">Date: {{date doc.date}}</div>
    </div>
  </div>

  <div class="grid-2" style="margin-bottom: 20px;">
    <div class="card">
      <div class="card-title">Bill To</div>
      <div style="font-size: 14px; font-weight: 700;">{{doc.partyName}}</div>
      <div class="muted">{{doc.billingAddress.line1}} {{doc.billingAddress.line2}}</div>
      <div class="muted">{{doc.billingAddress.city}} {{doc.billingAddress.state}}</div>
      {{#if doc.partyGstin}}<div style="margin-top: 4px;"><strong>GSTIN:</strong> {{doc.partyGstin}}</div>{{/if}}
    </div>
    <div class="card">
      <div class="card-title">Ship To</div>
      <div style="font-weight: 600;">{{doc.partyName}}</div>
      {{#if doc.shippingAddress.line1}}
        <div class="muted">{{doc.shippingAddress.line1}} {{doc.shippingAddress.line2}}</div>
        <div class="muted">{{doc.shippingAddress.city}} {{doc.shippingAddress.state}}</div>
      {{else}}
        <div class="muted">Same as billing address</div>
      {{/if}}
    </div>
  </div>

  <table class="items-table">
    <thead>
      <tr style="background: #1F2937;">
        <th class="center" style="width: 36px;">#</th>
        <th>Item &amp; Description</th>
        <th class="center" style="width: 80px;">HSN</th>
        <th class="num" style="width: 60px;">Qty</th>
        <th class="num" style="width: 90px;">Rate</th>
        <th class="num" style="width: 75px;">Disc</th>
        <th class="num" style="width: 65px;">Tax</th>
        <th class="num" style="width: 105px;">Amount</th>
      </tr>
    </thead>
    <tbody>
      {{#each doc.items}}
      <tr>
        <td class="center muted">{{inc @index}}</td>
        <td><strong>{{this.name}}</strong></td>
        <td class="center muted">{{#if this.hsn}}{{this.hsn}}{{else}}-{{/if}}</td>
        <td class="num bold">{{this.qty}}</td>
        <td class="num">{{money this.price}}</td>
        <td class="num muted">{{money this.discount}}</td>
        <td class="num muted">{{this.taxRate}}%</td>
        <td class="num bold" style="color: #1F2937;">{{money this.amount}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="grid-2" style="margin-top: 20px; align-items: flex-start;">
    <div style="flex: 1.1; display: flex; flex-direction: column; gap: 12px;">
      <div class="card">
        <div class="card-title">Amount in Words</div>
        <div style="font-weight: 600;">{{words doc.grandTotal}}</div>
      </div>
      {{#if upiQr}}
      <div class="card" style="display: flex; align-items: center; gap: 12px;">
        <img src="{{upiQr}}" alt="UPI QR" style="width: 80px; height: 80px;" />
        <div>
          <div class="card-title">UPI Payment QR</div>
          <div style="font-weight: 700;">{{company.upiId}}</div>
        </div>
      </div>
      {{/if}}
    </div>
    <div style="flex: 0.9;" class="card">
      <div class="card-title" style="border-bottom: 1px solid var(--border); padding-bottom: 4px; margin-bottom: 8px;">Summary</div>
      <table class="totals-table">
        <tr><td class="muted">Subtotal</td><td class="right bold">{{money doc.subtotal company.currencySymbol}}</td></tr>
        {{#if doc.docDiscount}}<tr><td class="muted">Discount</td><td class="right">-{{money doc.docDiscount company.currencySymbol}}</td></tr>{{/if}}
        {{#if doc.cgst}}<tr><td class="muted">CGST</td><td class="right">{{money doc.cgst company.currencySymbol}}</td></tr><tr><td class="muted">SGST</td><td class="right">{{money doc.sgst company.currencySymbol}}</td></tr>{{/if}}
        {{#if doc.igst}}<tr><td class="muted">IGST</td><td class="right">{{money doc.igst company.currencySymbol}}</td></tr>{{/if}}
        {{#if doc.roundOff}}<tr><td class="muted">Round Off</td><td class="right">{{money doc.roundOff company.currencySymbol}}</td></tr>{{/if}}
        <tr class="grand-row" style="background: #F3F4F6;"><td style="color: #1F2937;">Grand Total</td><td class="right" style="color: #1F2937;">{{money doc.grandTotal company.currencySymbol}}</td></tr>
      </table>
    </div>
  </div>

  <div class="signature-grid">
    <div class="signature-box"><div class="signature-line">Customer Signature</div></div>
    <div class="signature-box"><div class="signature-line">Prepared By</div></div>
    <div class="signature-box">
      {{#if company.signature}}<img src="{{company.signature}}" alt="Sign" style="max-height: 48px;" /><br/>{{/if}}
      <div class="signature-line">Authorized Signatory</div>
      <div class="muted" style="font-size: 10.5px;">for {{company.name}}</div>
    </div>
  </div>
</div>
