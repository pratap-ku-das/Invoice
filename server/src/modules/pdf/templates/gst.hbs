<div class="doc" style="padding: 20px 24px;">
  <!-- Vyapar Style Top Banner Header -->
  <div style="border: 1.5px solid var(--primary); border-radius: 8px; overflow: hidden; margin-bottom: 16px;">
    <!-- Title Strip -->
    <div style="background: var(--primary); color: #fff; padding: 6px 14px; display: flex; justify-content: space-between; align-items: center;">
      <span style="font-size: 14px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase;">TAX INVOICE</span>
      <span style="font-size: 11px; font-weight: 600; opacity: 0.9;">ORIGINAL FOR RECIPIENT</span>
    </div>

    <!-- Company + Invoice Metadata Block -->
    <div style="padding: 12px 14px; display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; background: #fff;">
      <div style="flex: 1.2;">
        {{#if company.logo}}
          <img src="{{company.logo}}" alt="company logo" class="company-logo" style="max-height: 52px; margin-bottom: 6px;" />
        {{/if}}
        <div class="company-name" style="font-size: 20px; font-weight: 800; color: var(--primary);">{{company.name}}</div>
        <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 2px;">{{formatAddress company.address}}</div>
        {{#if company.gstin}}
          <div style="font-size: 11.5px; font-weight: 700; color: var(--text-main); margin-top: 4px;">
            <span style="background: #EFF6FF; color: #1D4ED8; padding: 2px 6px; border-radius: 4px; border: 1px solid #BFDBFE;">GSTIN: {{company.gstin}}</span>
          </div>
        {{/if}}
        <div style="font-size: 11.5px; color: var(--text-muted); margin-top: 4px;">{{formatContactLine company.phone company.email}}</div>
      </div>

      <div style="flex: 0.8; text-align: right;">
        <table style="width: 100%; font-size: 11.5px; border-collapse: collapse;">
          <tr>
            <td style="padding: 2px 0; color: var(--text-muted); text-align: right;">Invoice No:</td>
            <td style="padding: 2px 0 2px 8px; font-weight: 800; font-size: 13px; color: var(--primary); text-align: right;">#{{doc.number}}</td>
          </tr>
          <tr>
            <td style="padding: 2px 0; color: var(--text-muted); text-align: right;">Invoice Date:</td>
            <td style="padding: 2px 0 2px 8px; font-weight: 700; text-align: right;">{{date doc.date}}</td>
          </tr>
          {{#if doc.dueDate}}
          <tr>
            <td style="padding: 2px 0; color: var(--text-muted); text-align: right;">Due Date:</td>
            <td style="padding: 2px 0 2px 8px; font-weight: 700; text-align: right;">{{date doc.dueDate}}</td>
          </tr>
          {{/if}}
          <tr>
            <td style="padding: 2px 0; color: var(--text-muted); text-align: right;">State / POS:</td>
            <td style="padding: 2px 0 2px 8px; font-weight: 700; text-align: right;">{{#if doc.placeOfSupply}}{{doc.placeOfSupply}}{{else}}{{company.address.state}}{{/if}}</td>
          </tr>
        </table>
      </div>
    </div>
  </div>

  <!-- Customer Bill To / Ship To Cards -->
  <div class="grid-2" style="margin-bottom: 16px;">
    <div class="card" style="border-left: 3px solid var(--primary);">
      <div class="card-title" style="color: var(--primary); font-weight: 800;">Billed To (Customer Details)</div>
      <div style="font-size: 14px; font-weight: 800; color: var(--text-main);">{{doc.partyName}}</div>
      <div class="muted" style="font-size: 11.5px;">{{doc.billingAddress.line1}} {{doc.billingAddress.line2}}</div>
      <div class="muted" style="font-size: 11.5px;">{{doc.billingAddress.city}}{{#if doc.billingAddress.state}}, {{doc.billingAddress.state}}{{/if}} {{doc.billingAddress.pincode}}</div>
      <div style="margin-top: 4px; font-size: 11.5px;">
        <strong>GSTIN / UIN:</strong> {{#if doc.partyGstin}}<span style="font-weight: 700; color: var(--primary);">{{doc.partyGstin}}</span>{{else}}<span class="muted">URP (Unregistered)</span>{{/if}}
      </div>
      {{#if doc.partyPhone}}<div class="muted" style="font-size: 11.5px;">Phone: {{doc.partyPhone}}</div>{{/if}}
    </div>

    <div class="card" style="border-left: 3px solid #64748B;">
      <div class="card-title">Shipped To / Consignee</div>
      <div style="font-size: 13.5px; font-weight: 700;">{{doc.partyName}}</div>
      {{#if doc.shippingAddress.line1}}
        <div class="muted" style="font-size: 11.5px;">{{doc.shippingAddress.line1}} {{doc.shippingAddress.line2}}</div>
        <div class="muted" style="font-size: 11.5px;">{{doc.shippingAddress.city}}{{#if doc.shippingAddress.state}}, {{doc.shippingAddress.state}}{{/if}} {{doc.shippingAddress.pincode}}</div>
      {{else}}
        <div class="muted" style="font-size: 11.5px;">Same as billing address</div>
      {{/if}}
      {{#if doc.eWayBillNo}}<div style="margin-top: 4px; font-size: 11.5px;"><span class="muted">e-Way Bill No:</span> <strong>{{doc.eWayBillNo}}</strong></div>{{/if}}
    </div>
  </div>

  <!-- Items Table (Vyapar Style) -->
  <table class="items-table">
    <thead>
      <tr>
        <th style="width: 28px;" class="center">#</th>
        <th>Item Description</th>
        <th class="center" style="width: 65px;">HSN/SAC</th>
        <th class="num" style="width: 48px;">Qty</th>
        <th class="num" style="width: 75px;">Rate</th>
        <th class="num" style="width: 65px;">Disc</th>
        <th class="num" style="width: 75px;">Taxable</th>
        <th class="num" style="width: 55px;">GST %</th>
        <th class="num" style="width: 85px;">Amount</th>
      </tr>
    </thead>
    <tbody>
      {{#each doc.items}}
      <tr>
        <td class="center muted">{{inc @index}}</td>
        <td>
          <strong style="color: var(--text-main);">{{this.name}}</strong>
          {{#if this.description}}<div class="muted" style="font-size: 10.5px;">{{this.description}}</div>{{/if}}
        </td>
        <td class="center muted">{{#if this.hsn}}{{this.hsn}}{{else}}-{{/if}}</td>
        <td class="num bold">{{this.qty}}</td>
        <td class="num">{{money this.price}}</td>
        <td class="num muted">{{#if this.discountValue}}{{money this.discountValue}}{{else}}-{{/if}}</td>
        <td class="num bold">{{money this.taxable}}</td>
        <td class="num muted">{{this.taxRate}}%</td>
        <td class="num bold" style="color: var(--primary);">{{money this.amount}}</td>
      </tr>
      {{/each}}
    </tbody>
    <tfoot>
      <tr style="background: #F1F5F9; font-weight: 700; font-size: 11.5px;">
        <td colspan="3" style="padding: 8px 12px;">Total Items: {{doc.totalItems}}</td>
        <td class="num" style="padding: 8px 12px; color: var(--primary);">{{doc.totalQty}}</td>
        <td colspan="2"></td>
        <td class="num" style="padding: 8px 12px;">{{money doc.subtotal}}</td>
        <td></td>
        <td class="num" style="padding: 8px 12px; font-size: 13px; color: var(--primary);">{{money doc.grandTotal company.currencySymbol}}</td>
      </tr>
    </tfoot>
  </table>

  <!-- HSN Tax Breakdown Table (Vyapar / Tally Style) -->
  {{#if doc.hsnSummary}}
  <div style="margin-top: 16px;">
    <div style="font-size: 11px; font-weight: 800; text-transform: uppercase; color: var(--text-muted); margin-bottom: 4px;">HSN / SAC Tax Summary</div>
    <table style="width: 100%; border: 1px solid var(--border); border-radius: 6px; overflow: hidden; font-size: 11px;">
      <thead style="background: #F8FAFC; border-bottom: 1px solid var(--border);">
        <tr>
          <th style="padding: 6px 10px; text-align: left;">HSN/SAC</th>
          <th style="padding: 6px 10px; text-align: right;">Taxable Amount</th>
          <th style="padding: 6px 10px; text-align: right;">CGST</th>
          <th style="padding: 6px 10px; text-align: right;">SGST</th>
          <th style="padding: 6px 10px; text-align: right;">IGST</th>
          <th style="padding: 6px 10px; text-align: right;">Total Tax</th>
        </tr>
      </thead>
      <tbody>
        {{#each doc.hsnSummary}}
        <tr style="border-bottom: 1px solid var(--border);">
          <td style="padding: 5px 10px; font-weight: 600;">{{this.hsn}}</td>
          <td style="padding: 5px 10px; text-align: right;">{{money this.taxable}}</td>
          <td style="padding: 5px 10px; text-align: right;">{{money this.cgst}}</td>
          <td style="padding: 5px 10px; text-align: right;">{{money this.sgst}}</td>
          <td style="padding: 5px 10px; text-align: right;">{{money this.igst}}</td>
          <td style="padding: 5px 10px; text-align: right; font-weight: 700;">{{money this.totalTax}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
  {{/if}}

  <!-- Summary Grid: Words + QR + Totals -->
  <div class="grid-2" style="margin-top: 16px; align-items: flex-start;">
    <div style="flex: 1.1; display: flex; flex-direction: column; gap: 10px;">
      <div class="card" style="background: #F8FAFC; border-left: 3px solid var(--primary);">
        <div class="card-title">Amount in Words</div>
        <div style="font-size: 12.5px; font-weight: 700; color: var(--text-main);">{{words doc.grandTotal}}</div>
      </div>

      {{#if upiQr}}
      <div class="card" style="display: flex; align-items: center; gap: 12px; background: #EFF6FF; border-color: #BFDBFE;">
        <img src="{{upiQr}}" alt="UPI QR" style="width: 76px; height: 76px; border-radius: 6px; border: 1px solid #93C5FD;" />
        <div>
          <div class="card-title" style="color: #1D4ED8; margin-bottom: 2px;">Scan &amp; Pay via UPI</div>
          <div style="font-weight: 800; font-size: 13px; color: #1E40AF;">Pay ₹{{doc.balanceAmount}} using GPay / PhonePe / Paytm</div>
          {{#if company.upiId}}<div class="muted" style="font-size: 11px; margin-top: 2px;">UPI ID: <strong>{{company.upiId}}</strong></div>{{/if}}
        </div>
      </div>
      {{/if}}
    </div>

    <div style="flex: 0.9;" class="card">
      <table class="totals-table" style="font-size: 12px;">
        <tr>
          <td class="muted">Subtotal (Taxable)</td>
          <td class="right bold">{{money doc.subtotal company.currencySymbol}}</td>
        </tr>
        {{#if doc.cgst}}
        <tr>
          <td class="muted">Central Tax (CGST)</td>
          <td class="right">{{money doc.cgst company.currencySymbol}}</td>
        </tr>
        {{/if}}
        {{#if doc.sgst}}
        <tr>
          <td class="muted">State Tax (SGST)</td>
          <td class="right">{{money doc.sgst company.currencySymbol}}</td>
        </tr>
        {{/if}}
        {{#if doc.igst}}
        <tr>
          <td class="muted">Integrated Tax (IGST)</td>
          <td class="right">{{money doc.igst company.currencySymbol}}</td>
        </tr>
        {{/if}}
        {{#if doc.shippingCharge}}
        <tr>
          <td class="muted">Shipping &amp; Delivery</td>
          <td class="right">{{money doc.shippingCharge company.currencySymbol}}</td>
        </tr>
        {{/if}}
        {{#if doc.roundOff}}
        <tr>
          <td class="muted">Round Off</td>
          <td class="right">{{money doc.roundOff company.currencySymbol}}</td>
        </tr>
        {{/if}}
        <tr class="grand-row">
          <td style="font-size: 14px; font-weight: 800;">Grand Total</td>
          <td class="right" style="font-size: 16px; font-weight: 900; color: var(--primary);">{{money doc.grandTotal company.currencySymbol}}</td>
        </tr>
        {{#if doc.paidAmount}}
        <tr>
          <td style="color: #047857; font-weight: 700; padding-top: 6px;">Received / Paid</td>
          <td class="right" style="color: #047857; font-weight: 800; padding-top: 6px;">{{money doc.paidAmount company.currencySymbol}}</td>
        </tr>
        {{/if}}
        {{#if doc.balanceAmount}}
        <tr>
          <td style="color: #B91C1C; font-weight: 800; padding-top: 4px;">Balance Due</td>
          <td class="right" style="color: #B91C1C; font-weight: 900; font-size: 13.5px; padding-top: 4px;">{{money doc.balanceAmount company.currencySymbol}}</td>
        </tr>
        {{/if}}
      </table>
    </div>
  </div>

  <!-- Bank Details & Terms -->
  <div class="grid-2" style="margin-top: 16px;">
    {{#if company.bankName}}
    <div class="card" style="border-left: 3px solid #059669;">
      <div class="card-title" style="color: #059669;">Bank Payment Account</div>
      <div style="font-size: 13px; font-weight: 800;">{{company.bankName}}</div>
      <div style="font-size: 11.5px;"><span class="muted">A/C Holder:</span> <strong>{{#if company.bankAccountName}}{{company.bankAccountName}}{{else}}{{company.name}}{{/if}}</strong></div>
      <div style="font-size: 11.5px;"><span class="muted">A/C Number:</span> <strong style="font-family: monospace; font-size: 12.5px;">{{company.bankAccount}}</strong></div>
      <div style="font-size: 11.5px;"><span class="muted">IFSC Code:</span> <strong style="font-family: monospace;">{{company.bankIfsc}}</strong></div>
    </div>
    {{/if}}

    {{#if doc.terms}}
    <div class="card">
      <div class="card-title">Terms &amp; Conditions</div>
      <div class="muted" style="white-space: pre-line; font-size: 10.5px; line-height: 1.4;">{{doc.terms}}</div>
    </div>
    {{/if}}
  </div>

  <!-- Signatures -->
  <div class="signature-grid" style="margin-top: 24px;">
    <div class="signature-box"><div class="signature-line">Customer Signature</div></div>
    <div class="signature-box"><div class="signature-line">Checked By</div></div>
    <div class="signature-box">
      {{#if company.signature}}<img src="{{company.signature}}" alt="Sign" style="max-height: 48px; object-fit: contain; margin-bottom: 4px;" /><br/>{{/if}}
      <div class="signature-line">Authorized Signatory</div>
      <div class="muted" style="font-size: 10.5px;">for {{company.name}}</div>
    </div>
  </div>
</div>
